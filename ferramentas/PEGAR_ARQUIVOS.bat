@echo off
setlocal enabledelayedexpansion
rem Copia para PARA_O_CLAUDE_4 os arquivos que faltam, mantendo a pasta de origem
set "RAIZ=%~dp0"
set "DAT=%RAIZ%JOGO\DAT"
set "OUT=%RAIZ%PARA_O_CLAUDE_4"
if not exist "%DAT%" (
  echo ERRO: nao achei a pasta JOGO\DAT. Coloque este arquivo na mesma pasta do APLICAR_TRADUCAO.bat
  pause
  goto :eof
)
if exist "%OUT%" rmdir /s /q "%OUT%"
mkdir "%OUT%"
set /a ACHADOS=0
for /d %%S in ("%DAT%\*") do (
  for %%N in (00002 00003 00004 00005 00006 00007 00008 00009 00010 00011 00012 00017 00037 01432 01433 01434 01435 01436 01437 01438 01439 01440 01441 01442 01443 01444 01445 01446 01447 01448 01449 01450 01451 01452 01453 01454 01455 01456 01457 01458 01459 01460 01461 01462 01463 01464 01465 01466 01467 01468 01469 01470 01471 01472 01473 01474 01475 01476 01477 01478 01479 01480 01481 01482 01483 01484 01485 01486 01487 01488 01489 01490 01491 01492 01493 01494 01495 01496 01497 01498 01499 01500 01501 01502 01503 01504 01505 01506 01507 01508 01509 01510 01511 01512 01513 01514 01515 01516 01517 01518 01519 01520 01521 01522 01523 01524 01525 01526 01527 01528 01529 01530 01531 01532 01533 01534 01535 01536 01537 01538 01642 01685 01689 01695 01719 01720 01721 01722 01723 01724 01725 01726 01727 01728 01729 01730 01731 01732 01733 01734 01735 01736 01737 01738 01744 01756 01757 01758 01759 01760 01761 01762 01763 01764 01765 01766 01767) do (
    for %%F in ("%%S\%%N.*") do (
      if not exist "%OUT%\%%~nxS" mkdir "%OUT%\%%~nxS"
      copy /y "%%F" "%OUT%\%%~nxS\" >nul
      echo %%~nxS\%%~nxF>> "%OUT%\lista.txt"
      set /a ACHADOS+=1
    )
  )
)
echo.
echo Pronto! Arquivos copiados: !ACHADOS!
echo Agora compacte a pasta PARA_O_CLAUDE_4 em ZIP e mande para o Claude.
echo Se deu 0, mande so o print desta janela.
pause
